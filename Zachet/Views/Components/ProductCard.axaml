<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Zachet.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Zachet.Views.ProductCard"
             x:DataType="vm:ProductCardItem"
             Background="{StaticResource Color.Background}">
    <Grid Background="{StaticResource Color.Background}" Margin="12">
        <Border Background="{StaticResource Color.AdditionalBackground}"
                BorderBrush="{StaticResource Color.Accent}"
                BorderThickness="1"
                Padding="16 12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ProductType, FallbackValue=Тип}"
                                   Foreground="{StaticResource Color.Accent}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="|"
                                   Foreground="{StaticResource Color.Accent}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProductName, FallbackValue=Наименование продукта}"
                                   Foreground="{StaticResource Color.Accent}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="24 0 0 0"
                               VerticalAlignment="Center"
                               Text="{Binding ProductionTime, FallbackValue=Время изготовления}"
                               Foreground="{StaticResource Color.Accent}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </Grid>

                <TextBlock Text="{Binding Article, FallbackValue=Артикул}"
                           Foreground="{StaticResource Color.Accent}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding MinPartnerPrice, FallbackValue=Минимальная стоимость для партнера}"
                           Foreground="{StaticResource Color.Accent}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding MainMaterial, FallbackValue=Основной материал}"
                           Foreground="{StaticResource Color.Accent}"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
