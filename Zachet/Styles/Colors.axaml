<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <Color x:Key="Color.Background">#FFFFFF</Color>
    <Color x:Key="Color.AdditionalBackground">#D2DFFF</Color>
    <Color x:Key="Color.Accent">#355CBD</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.AdditionalBackground" Color="{StaticResource Color.AdditionalBackground}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
</ResourceDictionary>
